{
  "schemaVersion": 1,
  "id": "etsy-listing-2026-09",
  "marketplace": "Etsy",
  "verifiedAt": "2026-09-28",
  "sources": [
    {
      "url": "https://help.etsy.com/hc/en-us/articles/115015663347-Requirements-and-Best-Practices-for-Images-in-Your-Etsy-Shop",
      "scope": "Supported image formats, transparency behavior, listing image resolution, orientation, and thumbnail guidance"
    },
    {
      "url": "https://help.etsy.com/hc/en-us/articles/360053206073-How-to-Add-Listing-Videos",
      "scope": "Listing video formats, duration, size, resolution, aspect ratio, and audio behavior; the article was last edited on 2026-07-01"
    },
    {
      "url": "https://help.etsy.com/hc/en-us/articles/115015628707-How-to-Create-a-Listing?segment=selling",
      "scope": "Current listing photo and video count guidance"
    }
  ],
  "constraints": {
    "images": {
      "supportedFormats": ["jpg", "gif", "png", "svg", "heic"],
      "transparencySupported": false,
      "transparentPixelsAppearAs": "black",
      "recommendedMinimumWidthPx": 2000,
      "recommendedMinimumHeightPx": 2000,
      "firstImageMinimumWidthPx": 635,
      "firstImageMinimumHeightPx": 635,
      "preferredPrimaryOrientation": ["landscape", "square"],
      "maximumListingImages": 20,
      "colorProfile": "sRGB"
    },
    "video": {
      "supportedFormats": ["mp4", "mov", "flv", "aac", "avi", "3gp", "mpeg"],
      "minimumDurationSeconds": 5,
      "maximumDurationSeconds": 15,
      "durationSourceConflict": "The dedicated video guide says 3–15 seconds; the listing guide says 5–15 seconds. This preset uses the safer 5–15 second intersection.",
      "maximumFileSizeLabel": "100 MB",
      "maximumBytesInterpretation": 100000000,
      "maximumListingVideos": 2,
      "minimumResolutionPx": 500,
      "idealResolutionPx": 1080,
      "aspectRatioSourceText": "The video aspect ratio should be 2:1 or 1:2.",
      "aspectRatioRange": {
        "widest": "2:1",
        "tallest": "1:2"
      },
      "aspectRatioReading": "Read as the range from 2:1 (widest) to 1:2 (tallest), square included. The sentence names only the two extremes, but square listing videos upload (Etsy's seller forum thread \"Uploading Videos - Square video being stretched\" is about one). The etsy-listing-2026-08 preset read the two values as the only accepted shapes and refused 1:1.",
      "audioAfterUpload": "removed"
    }
  },
  "validation": {
    "images": {
      "maximumCount": 20,
      "formats": ["jpg", "png"],
      "minimumWidth": 2000,
      "minimumHeight": 2000,
      "requireOpaque": true
    },
    "video": {
      "maximumCount": 2,
      "formats": ["mp4"],
      "minimumDurationMs": 5000,
      "maximumDurationMs": 15000,
      "minimumWidth": 500,
      "minimumHeight": 500,
      "minimumAspectRatio": 0.5,
      "maximumAspectRatio": 2,
      "audio": "none",
      "maximumBytes": 100000000
    }
  },
  "recipeDefaults": {
    "image": {
      "width": 2000,
      "height": 2000,
      "format": "png",
      "opaqueBackgroundRequired": true
    },
    "video": {
      "width": 1920,
      "height": 1080,
      "durationMs": 5000,
      "fps": 30,
      "format": "mp4",
      "codec": "h264",
      "pixelFormat": "yuv420p",
      "audio": "none"
    }
  }
}

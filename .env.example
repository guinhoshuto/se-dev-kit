# Local development needs no Vercel credentials. Never use local storage on Vercel.
STUDIO_STORAGE=local
STUDIO_DATA_DIR=.studio-data
STUDIO_EXECUTION=local
# Hosted: STUDIO_STORAGE=blob and STUDIO_EXECUTION=vercel
# BLOB_READ_WRITE_TOKEN=
# STUDIO_SANDBOX_SNAPSHOT_ID=
# VERCEL_OIDC_TOKEN=  # development only; Vercel supplies production identity
# BLOB_STORE_ID=    # alternative to a static Blob token with Vercel OIDC
# Optional shared creation key; no accounts. Clients send X-Studio-Key.
# STUDIO_CREATE_KEY=
# Optional: explicit installed Chrome, FFmpeg and ffprobe paths (local only).
# SE_WIDGET_STUDIO_BROWSER=
# STUDIO_FFMPEG_PATH=
# STUDIO_FFPROBE_PATH=

      "name": "^a test npm test skipped NOT COVERED"
    },
    {
      "file": "scripts/gate.mjs",
      "from": "${tests ? ` npm test also ${skippedTests}` : ''}",
      "to": "",
      "test": "tests/unit/gate.test.mjs",
      "name": "^a test npm test skipped NOT COVERED"
    },
    {
      "file": "scripts/gate.mjs",
      "from": "else if (tests) {last",

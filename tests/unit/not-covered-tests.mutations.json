{
  "mutations": [
    {
      "file": "scripts/lib/test-history.mjs",
      "from": "# NOT COVERED: (.+)$/gm",
      "to": "# (.+)$/gm",
      "test": "tests/unit/run-tests.test.mjs",
      "name": "^a suite's log lists each test skipped NOT COVERED"
    },
    {
      "file": "scripts/lib/test-history.mjs",

      "from": "output.match(/^NOT COVERED(?:: | in [a-z][a-z:]*: ).+$/gm)",
      "to": "output.match(/^.*NOT COVERED(?:: | in [a-z][a-z:]*: ).+$/gm)",
      "test": "tests/unit/gate.test.mjs",
      "name": "^a test npm test skipped NOT COVERED"
    },
    {
      "file": "scripts/gate.mjs",
      "from": "output.match(/^NOT COVERED(?:: | in [a-z][a-z:]*: ).+$/gm)",
      "to": "output.match(/^NOT COVERED(?:: ).+$/gm)",
